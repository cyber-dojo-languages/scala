# The floating tag of the same alpine-musl JDK the java image uses, so a
# rebuild picks up the newest stable JDK. It is published as an index holding
# real amd64 and arm64 layers, so each runner builds from binaries its own
# kernel can exec.
FROM bellsoft/liberica-openjdk-alpine-musl:latest
LABEL maintainer=jon@jaggersoft.com

ENV SCALA_HOME=/usr/share/scala

COPY install.sh .
RUN ./install.sh && rm ./install.sh

ENV PATH=${PATH}:${SCALA_HOME}/bin
